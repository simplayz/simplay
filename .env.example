# Simplayz environment template. Copy to .env.local for local use.
# Never commit real values.

# Required for durable server-side saves. Relative paths resolve from the
# process working directory. The default is ./data/simplayz.sqlite.
SIMPLAYZ_DB_PATH=./data/simplayz.sqlite

# Anonymous session cookie. Leave unset to use Secure in production and
# non-Secure in development. Set to 1 only when production is served over HTTPS
# through a trusted proxy and the browser must receive a Secure cookie.
# SIMPLAYZ_COOKIE_SECURE=0

# Optional live advisor. All three values must be set to enable the proxy.
# The browser never receives these values; only the server reads them.
# SIMPLAYZ_ADVISOR_API_KEY=replace-with-operator-key
# SIMPLAYZ_ADVISOR_BASE_URL=https://api.openai.com/v1
# SIMPLAYZ_ADVISOR_MODEL=gpt-4o-mini
# SIMPLAYZ_ADVISOR_TIMEOUT_MS=12000

# Comma-separated extra hostnames allowed to access the Next dev server from a
# preview origin. Do not use "*". The loopback address 127.0.0.1 is always
# allowed; production builds do not use this setting.
# SIMPLAYZ_ALLOWED_DEV_ORIGINS=preview.example.com

# Only enable when requests always arrive through a trusted reverse proxy that
# overwrites X-Forwarded-For. Used for the advisor's anonymous IP rate limit.
# SIMPLAYZ_TRUST_PROXY=0
